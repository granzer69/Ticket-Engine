# Dependencies - installed locally, never committed (huge, OS-specific)
node_modules/

# Environment variables - contains secrets (DB passwords, API keys)
.env
.env.*

# Application logs - generated at runtime, not source code
*.log

# Build outputs - generated from source, rebuilt on deploy
dist/
build/

# k6 load testing cache - temporary test artifacts
.k6/

# Compressed archives - binary files, too large for git
*.zip

# Test coverage reports - generated by test runners
coverage/

# OS-generated files
.DS_Store
Thumbs.db

# Go binary outputs
testapp
*.exe

# IDE files
.vscode/
.idea/

# pnpm store
.pnpm-store/
